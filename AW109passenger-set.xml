<!--
  Usage: fgfs - -prop:/sim/remote/pilot-callsign="remote pilot callsign" - -aircraft=Fi-156-passenger
-->
<PropertyList>

 <sim>

  <description>AgustaWestland AW109 "Grand New" Multiplayer passenger</description>
  <author>Anders Gidenstam</author>
  <status>alpha</status>
  <aircraft-version>$Id$</aircraft-version>
  <variant-of>Wildcat_AH1</variant-of>
  
  <flight-model>null</flight-model>

  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>

	<startup>
			<splash-texture>Aircraft/aw109/Splash.jpg</splash-texture>
		</startup>

		<previews>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/Base Profile Screenshot 2025.12.04 - 13.32.26.52.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/Base Profile Screenshot 2025.12.04 - 13.33.11.47.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/Base Profile Screenshot 2025.12.04 - 13.34.40.76.png</path>
			</preview>
			<preview>
				<type>interior</type>
				<splash type="bool">true</splash>
				<path>Splash/Base Profile Screenshot 2025.12.04 - 13.30.12.49.png</path>
			</preview>
			<preview>
				<type>interior</type>
				<splash type="bool">true</splash>
				<path>Splash/Base Profile Screenshot 2025.12.04 - 13.31.13.98.png</path>
			</preview>
		</previews>
	  
	




  <!-- 3d model -->
  <model>
   <path>Aircraft/aw109/Models/AW109GN-passenger.xml</path>
  </model>
  
<rendering>
    <refl_correction type="string">-0.41</refl_correction>
	<fresnel-factor>0.1</fresnel-factor>
    </rendering>
  
    <multiplay>
			<generic>
				  
        <!-- Nav lights on -->
      <int n="0" alias="/controls/switches/nav-lights-switch" />
      <!-- Beacon on -->
      <int n="1" alias="/controls/switches/beacon-switch" />
      <!-- Landing lights on -->
      <int n="2" alias="/controls/switches/landing-lights-switch" />
	    <!-- Taxi light on -->
      <int n="3" alias="/controls/switches/strobe-switch" />
	    <int n="6" alias="/gear/gear/ground-is-solid"/><!-- rotor particles -->
      <!-- Crashed -->
      <int n="7" alias="/sim/crashed" />
			
		
		   <float n="0" alias="/sim/model/bo105/doors/door[0]/position-norm"/>
				<float n="1" alias="/sim/model/bo105/doors/door[1]/position-norm"/>
				<float n="2" alias="/sim/model/bo105/doors/door[2]/position-norm"/>
				<float n="3" alias="/sim/model/bo105/doors/door[3]/position-norm"/>
				<float n="4" alias="/sim/model/bo105/doors/door[4]/position-norm"/>
				<float n="5" alias="/sim/model/bo105/doors/door[5]/position-norm"/>
	  
	  <float n="6" alias="/orientation/pitch-deg"/>	<!-- rotor particles -->
				<float n="7" alias="/position/gear-agl-m"/>	<!-- rotor particles -->
				<float n="8" alias="/orientation/roll-deg"/><!-- rotor particles -->
				<float n="9" alias="/rotors/main/torque"/>	<!-- rotor particles -->
		        <float n="10" alias="/controls/wiper/posp"/><!--wiper over MP -->
	<string n="1" alias="/sim/weight[5]/selected" /><!-- Payload over multiplayer -->
				
			</generic>
		</multiplay>

		<sound>
			<path>Aircraft/aw109/Sounds/sound.xml</path>
		</sound>


 <!--view-->
		<!--view-->
		<view n="0">
			<name>Cockpit</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
                                        <x-offset-m type="double">-0.30</x-offset-m><!--left-->
		      <y-offset-m type="double">-0.339</y-offset-m><!--up-->
			<z-offset-m type="double">-1.225</z-offset-m><!--back-->
				<pitch-offset-deg>-12</pitch-offset-deg>
				<default-field-of-view-deg type="double">75.0</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="101">
			<name>Rear cabin</name>
			<type>lookfrom</type>
			 <internal archive="y">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
                  <x-offset-m type="double">-0.0</x-offset-m><!--left-->
		      <y-offset-m type="double">-0.4</y-offset-m><!--up-->
			<z-offset-m type="double">-0</z-offset-m><!--back-->
				<pitch-offset-deg>-12</pitch-offset-deg>
				<default-field-of-view-deg type="double">75.0</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="102">
			<name>Cockpit cam</name>
			<type>lookfrom</type>
			 <internal archive="y">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
                  <x-offset-m type="double">-0.0</x-offset-m><!--left-->
		      <y-offset-m type="double">-0.3</y-offset-m><!--up-->
			<z-offset-m type="double">-1.2</z-offset-m><!--back-->
				<pitch-offset-deg>-12</pitch-offset-deg>
				<default-field-of-view-deg type="double">95.0</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="103">
			<name>Winch cam</name>
			<type>lookfrom</type>
			 <internal archive="y">false</internal>
        <config>
		 <from-model type="bool">true</from-model>
                  <x-offset-m type="double">0.9</x-offset-m><!--left-->
		      <y-offset-m type="double">-0.2</y-offset-m><!--up-->
			<z-offset-m type="double">0.3</z-offset-m><!--back-->
				<pitch-offset-deg>-85</pitch-offset-deg>
				<default-field-of-view-deg type="double">75.0</default-field-of-view-deg>
			</config>
		</view>
		
			<view n="104">
			<name>Belly cam</name>
			<type>lookfrom</type>
			 <internal archive="y">false</internal>
        <config>
		 <from-model type="bool">true</from-model>
                  <x-offset-m type="double">-0.0</x-offset-m><!--left-->
		      <y-offset-m type="double">-1.6</y-offset-m><!--up-->
			<z-offset-m type="double">-0</z-offset-m><!--back-->
				<pitch-offset-deg>-12</pitch-offset-deg>
				<default-field-of-view-deg type="double">100.0</default-field-of-view-deg>
			</config>
		</view>
		

		<view n="1">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="3">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="4">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="5">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>

		<view n="6">
			<config>
				<target-z-offset-m archive="y" type="double">-1</target-z-offset-m>
			</config>
		</view>


		
		




  

  <menubar>
   <default>
    <menu n="100">
     <label>AW109GN</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>
  
  
  



 </sim>
 
 	 <instrumentation>

        <mk-viii>                             <!-- http://wiki.flightgear.org/index.php/GPWS -->
           <serviceable>true</serviceable>    <!-- EGPWS_ENABLE -->
           <configuration-module>
              <category-1>   3 </category-1>  <!-- AIRCRAFT_MODE_TYPE_SELECT -->
              <category-8>                    <!-- RADIO_ALTITUDE_INPUT_SELECT -->
                 3 <!-- YASim --> 
              </category-8>
           </configuration-module>
           <inputs>                           <!-- Module I/O -->
            <arinc429>
               <decision-height-ncd> true </decision-height-ncd>
               <decision-height> 150 </decision-height>
            </arinc429>
           </inputs>
           <speaker>
              <volume>0</volume>
           </speaker>
        </mk-viii>

        <tcas>
            <serviceable type="bool">true</serviceable>
            <inputs>
                <mode type="int">3</mode>       <!-- 0=off, 1=standby, 2=TA-only, 3=auto(TA/RA) -->
            </inputs>
            <!--voice>
                <file-prefix type="string">Sounds/tcas/</file-prefix>
            </voice-->
            <speaker>                           <!-- Speaker Configuration -->
                <max-dist type="double">7</max-dist>        <!-- Max. distance where speaker is heard -->
                <reference-dist type="double">5</reference-dist> <!-- Distance to pilot -->
                <volume type="double"> 1 </volume>          <!-- Volume at reference distance -->
            </speaker>
            <range type="int">10</range>
        </tcas>

      

       

        <alerts>
            <gear-horn type="bool">0</gear-horn>
            <master-warning type="bool">1</master-warning>
            <master-caution type="bool">1</master-caution>
        </alerts>

   
	
    </instrumentation>

 <nasal>
 	<FG1000>
	<file>Aircraft/aw109/Nasal/FGUK1000.nas</file>
		
	</FG1000>
  <dual_control_tools>
   <file>Aircraft/Generic/DualControl/dual-control-tools.nas</file>
  </dual_control_tools>
  <aircraft_dual_control>
   <file>Aircraft/aw109/Nasal/109-dual-control.nas</file>
  </aircraft_dual_control>
  <dual_control>
   <file>Aircraft/Generic/DualControl/copilot-dual-control.nas</file>
  </dual_control>

 
 	
 </nasal>
</PropertyList>
