<?xml version="1.0"?>



<PropertyList>

<path>rpm.ac</path>

<animation>
      <type>material</type>
      
      <object-name>rpm</object-name>
     
       <emission>
     
      <red>   0.3 </red>
      <green> 0.3 </green>
      <blue>  0.9 </blue>
    </emission>
    </animation>

<animation>
	<type>select</type>
	<object-name>rpm</object-name>
	
	<condition>
	<or>
	
		<less-than>
			<property>rotors/main/rpm</property>
			<value>390</value>
		</less-than>
		<greater-than>
			<property>rotors/main/rpm</property>
			<value>490</value>
		</greater-than>
		</or>
	</condition>
</animation>


<!--  LoD  -->

<animation> 
	<type>range</type>
	<min-m>0</min-m>
	<max-m>10</max-m>
</animation>

 </PropertyList>