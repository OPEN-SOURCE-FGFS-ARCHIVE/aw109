<?xml version="1.0"?>



<PropertyList>

<path>cit-warn.ac</path>

  <animation>
      <type>material</type>
      
      <object-name>warn</object-name>
     
       <emission>
     
      <red>   0.9 </red>
      <green> 0.0 </green>
      <blue>  0.0 </blue>
    </emission>
    </animation>

<animation>
	<type>select</type>
	<object-name>warn</object-name>
	 <condition>
		
			 <or>
		<less-than>
			<property>consumables/fuel/total-fuel-lbs</property>
			<value>190</value>
		</less-than>

		<not>
			<property>engines/engine[0]/running</property>
		</not>
	
		<less-than>
			<property>engines/engine/n1-rpm</property>
			<value>31000</value>
		</less-than>
	
		<less-than>
			<property>rotors/main/rpm</property>
			<value>352</value>
		</less-than>

		<less-than>
      <property>rotors/gear/mgb-oil-pressure-norm</property>
	  <value>3.5</value>
	  </less-than>
		
	   </or>
	
			
			</condition>
</animation>

 <animation>
      <type>material</type>
      
      <object-name>caution</object-name>
     
       <emission>
     
      <red>   0.9 </red>
      <green> 0.9 </green>
      <blue>  0.0 </blue>
    </emission>
    </animation>

<animation>
	<type>select</type>
	<object-name>caution</object-name>
	 <condition>
		<or>
		<less-than>
				<property>rotors/gear/mgb-oil-pressure-low</property>
						<value>0.89</value>
					</less-than>

		<less-than>
				<property>engines/engine/oil-pressure-bar</property>
						<value>1</value>
					</less-than>
	
		
	
		<less-than>
				<property>engines/engine/oil-temperature-degc</property>
						<value>31</value>
					</less-than>	
				<greater-than>
				<property>engines/engine/oil-temperature-degc</property>
						<value>131</value>
					</greater-than>
					
						
		
	   </or>
	
			
			</condition>
</animation>

<!--  LoD  -->

<animation> 
	<type>range</type>
	<min-m>0</min-m>
	<max-m>10</max-m>
</animation>

 </PropertyList>