				<property>sim/current-view/internal</property>
				<and>
				
				<equals>
				<property>controls/electric/engine/generator</property>
				<value>true</value>
				</equals>
				
				</and>
			</condition>
			<volume>
				<factor>0.014</factor>
			</volume>
			<position>
				<x>-1</x>
				<y>-0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>1</reference-dist>
			<max-dist>3</max-dist>
		</avionics>

