<!--
	thanks to the SAR simulation (GPL) for the helicopter sounds,
	and the Urban game (LGPL) for the weapon sounds

	+x = aft
	+y = left
	+z = up
-->

<PropertyList>
	<fx>


		<avionics>
			<name>avionics1</name>
			<mode>looped</mode>
			<path>Aircraft/aw109/Sounds/avionics_1.wav</path>
			<condition>
			
				<property>sim/current-view/internal</property>
				<and>
				<or>
				<equals>
				<property>controls/electric/directbat-switch</property>
				<value>true</value>
				</equals>
				<equals>
				<property>controls/electric/engine/generator</property>
				<value>true</value>
				</equals>
				</or>
				</and>
			</condition>
			<volume>
				<factor>0.01</factor>
			</volume>
			<position>
				<x>-1</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>1</reference-dist>
			<max-dist>3</max-dist>
		</avionics>

		<avionics>
			<name>avionics2</name>
			<mode>looped</mode>
			<path>Aircraft/aw109/Sounds/avionics_2.wav</path>
